        "targetDescription": "Edit Total Hours",
        "locatorHint": "[data-testid=total-hours-input]",
        "value": "7"
      },
      {
        "id": "step-5",
        "action": "assertValue",
        "targetDescription": "Total Hours field value is 7",
        "locatorHint": "[data-testid=total-hours-input]",
        "assertion": "7"
